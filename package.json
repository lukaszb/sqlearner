{
  "name": "sqlearner",
  "version": "0.1.0",
  "description": "Electron desktop app for learning SQL with a local SQLite dataset.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "setup:kagglehub": "python3 -m venv .venv && .venv/bin/python -m pip install kagglehub",
    "start": "electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json && npm run build:preload",
    "build:preload": "mkdir -p dist/preload && cp src/preload/index.cjs dist/preload/index.cjs",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "typecheck": "vue-tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint . --ext .ts,.vue",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.2",
    "vitest": "^3.1.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.sqlearner.app",
    "productName": "SQLearner",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.0.0": true,
    "esbuild@0.25.12": true
  }
}
